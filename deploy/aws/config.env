REGION=${REGION:-us-east-1}
export AWS_DEFAULT_REGION=$REGION
CLUSTER=${CLUSTER:-iris}
ACCOUNT=${ACCOUNT:-$(aws sts get-caller-identity --query Account --output text)}
BUCKET=${BUCKET:-iris-$ACCOUNT}

DRIVER_TYPE=${DRIVER_TYPE:-r6i.2xlarge}
WORKER_TYPE=${WORKER_TYPE:-i4i.2xlarge}
WORKERS=${WORKERS:-6}
EXECUTOR_MEMORY=${EXECUTOR_MEMORY:-24g}
DRIVER_DISK_GB=${DRIVER_DISK_GB:-100}
WORKER_DISK_GB=${WORKER_DISK_GB:-40}
MAX_HOURS=${MAX_HOURS:-6}

KEY_NAME=${KEY_NAME:-$CLUSTER-key}
KEY_FILE=${KEY_FILE:-$HOME/.ssh/$KEY_NAME.pem}
ROLE=${ROLE:-$CLUSTER-node}
SG_NAME=${SG_NAME:-$CLUSTER-cluster}
